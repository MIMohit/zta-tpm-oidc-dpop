# ==============================================================================
# Zero Trust Architecture (ZTA) Configuration
# ==============================================================================

# --- Service URLs ---
IDP_ISSUER=http://localhost:5173
VERIFIER_URL=http://localhost:4005
PIP_URL=http://localhost:4003
PDP_URL=http://localhost:4002
PEP_PUBLIC_URL=http://localhost:4001
RESOURCE_URL=http://127.0.0.1:5001
AGENT_URL=http://127.0.0.1:7000

# --- Storage & Data ---
# STORE options: file | memory | firebase (default: file)
STORE=file
ZTA_DATA_DIR=./data

# --- Identity Provider Mode ---
# IDP_MODE options: local | keycloak (default: local)
IDP_MODE=local

# --- Upstream Keycloak (Optional, only used when IDP_MODE=keycloak) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/zta-realm
KEYCLOAK_CLIENT_ID=zta-gate
KEYCLOAK_CLIENT_SECRET=

# --- Security Tokens & Secrets ---
# Internal token for service-to-service communication (mTLS abstraction)
ZTA_INTERNAL_TOKEN=dev-internal-zta-secret-token-change-in-production
# Bearer token for device registry administrative endpoints
ADMIN_TOKEN=dev-admin-zta-secret-token-change-in-production
# Session secret for IdP portal cookie sessions
SESSION_SECRET=dev-session-secret-change-in-production

# --- TPM Backend ---
# TPM_BACKEND options (default: sim):
#   sim         simulated TPM 2.0 (software keys in data/agent/<id>/tpm.json) - today's behaviour
#   tpm         real TPM 2.0 via tss.js; if unreachable the agent stays up and answers 503 tpm_unavailable
#   auto        real TPM if reachable, otherwise falls back to the simulated TPM with a loud warning
#   windows-ek  diagnostic only (reads the Windows EK via PowerShell)
TPM_BACKEND=sim
# Real-TPM transport (TPM_BACKEND=tpm|auto). TPM_DEVICE options (default: auto):
#   auto   win32 -> tbs, linux with /dev/tpmrm0 or /dev/tpm0 -> linux, otherwise tcp
#   tbs    Windows TPM Base Services (koffi -> tbs.dll)      [untested on hardware]
#   linux  /dev/tpmrm0 (kernel resource manager), then /dev/tpm0  [untested on hardware]
#   tcp    MS simulator protocol: IBM tpm_server / swtpm (npm run tpm:sim-server)
#   swtpm  swtpm TCP socket with control channel (TPM_SWTPM_CTRL_PORT)
# TPM_DEVICE=auto
# TPM_TCP_HOST=127.0.0.1
# TPM_TCP_PORT=2321            # platform port = TPM_TCP_PORT + 1
# TPM_SWTPM_CTRL_PORT=         # swtpm control channel port (when TPM_DEVICE=swtpm)
# TPM_TCP_POWERON=1            # send PowerOn + NvOn on connect (tcp only)
# TPM_CONNECT_TIMEOUT_MS=3000
# TPM_STATE_DIR=               # default data/agent/<AGENT_ID>/tpm (AK/K_B blobs, event log)
# TPM_EK_TYPE=auto             # auto | rsa | ecc | ecc384
# TPM_EK_CERT_FILE=            # path to EK certificate (DER/PEM file, e.g. for dev-hw AMD fTPM)
# TPM_EK_CHAIN_FILES=          # comma-separated intermediate certificate paths to include with evidence
# TPM_SRK_HANDLE=0x81000001    # persistent SRK handle (0x81000001 default, 0x81000101 on dev-hw AMD fTPM)
# TPM_EVENTLOG=auto            # auto | require | off (Linux event log reading)
# TPM_EVENTLOG_PATH=/sys/kernel/security/tpm0/binary_bios_measurements # path to binary TCG event log
# TPM_SIM_AUTOSTART=0          # start-zta.sh: with TPM_DEVICE=tcp, start + provision the software TPM

# --- Verifier: real-TPM evidence ---
# EK_ROOTS_DIR=./data/ek-roots          # trusted EK manufacturer roots (*.pem|*.cer|*.crt)
#                                       # data/ek-roots-dev/ (dev CA) is also trusted unless ZTA_ENV=production
# EK_EXTRA_ROOTS_DIRS=                  # comma/colon-separated list of additional root CA dirs (e.g. data/ek-roots/amd)
# EK_CERT_POLICY=require                # require | pinned-ok (accept an EK pinned in the inventory with --ek-pub)
# EK_CERT_IGNORE_EXPIRY=0               # tolerate odd EK cert validity periods
# VERIFIER_RV_PATH=                     # path to Reference Values file (default: fixtures/golden-boot.json, or fixtures/rv/*.json)
# VERIFIER_GOLDEN_TOFU=0                # dev only: trust the first enrolment PCR digest when no event log
# ZTA_ENV=development                   # production disables the dev EK roots

# --- Table 5 Protocol Parameters (seconds unless noted) ---
# Attestation Result (AR) token lifetime
ZTA_TAU_AR=120
# Access Token (AT) lifetime
ZTA_T_AT=300
# Client re-attestation interval
ZTA_T_RA=300
# DPoP nonce validity window
ZTA_T_NONCE=60
# DPoP proof replay window (jti cache) - must satisfy W_J >= T_n + delta
ZTA_W_JTI=120
# Permitted clock skew
ZTA_SKEW=30
# Risk thresholds (Algorithm 4)
ZTA_THETA_LOGIN=0.5
ZTA_THETA_DENY=0.85
# Step-up lifetime window
ZTA_T_SU=300

# --- Optional External Services ---
# Open Policy Agent URL (optional external PDP evaluator)
# OPA_URL=http://localhost:8181

# --- Testing, Diagnostic & Ablation Knobs (Default 0 / off in production) ---
# ZTA_DEBUG=1 enables dev-only endpoints such as POST /agent/debug/tamper (never in production)
ZTA_DEBUG=0
# Allow client to override socket IP via X-ZTA-Sim-IP for geo-anomaly evaluation
ZTA_SIM_IP_HEADER=0
# Ablation: skip DPoP cnf.jkt binding verification (legacy knob; testing only)
ZTA_ABLATE_CNF=0
# Ablation: skip DPoP nonce verification (legacy knob; testing only)
ZTA_ABLATE_NONCE=0
# Ablation switchboard: label or disabled guard (-M1..-M26 or M1..M26; e.g. -M16 disables cnf.jkt)
# ZTA_ABLATE=
# Baseline policy profile (B0: unauthenticated, B1: bearer token, B2: no continuous telemetry, B3: static ACL)
# ZTA_BASELINE=

# --- Firebase Service Account Credentials (Optional, only used when STORE=firebase) ---
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="your-service-account-email@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_URL="https://your-database-name.firebaseio.com"
