# testbed/config.env - Fleet configuration and resource definitions

# Fleet devices (plan §5)
FLEET_DEVICES=("dev-good" "dev-tampered" "dev-rogue" "dev-foreign")

# Virtual Machine sizing
RAM="1536M"
RAM_MB=1536
SMP=2

# dev-good: Golden image, genuine swtpm EK from good CA, inventoried
PORT_AGENT_dev_good=7101
PORT_SSH_dev_good=2221
PORT_SWTPM_dev_good=6101
PORT_CTRL_dev_good=6201
CA_dev_good="good"
PROFILE_dev_good="p384"
USER_dev_good="alice"
IMAGE_dev_good="golden"

# dev-tampered: Tampered kernel/bootloader image, genuine swtpm EK from good CA, inventoried
PORT_AGENT_dev_tampered=7102
PORT_SSH_dev_tampered=2222
PORT_SWTPM_dev_tampered=6102
PORT_CTRL_dev_tampered=6202
CA_dev_tampered="good"
PROFILE_dev_tampered="p384"
USER_dev_tampered="alice"
IMAGE_dev_tampered="tampered"

# dev-rogue: Genuine swtpm EK from good CA, NOT in inventory
PORT_AGENT_dev_rogue=7103
PORT_SSH_dev_rogue=2223
PORT_SWTPM_dev_rogue=6103
PORT_CTRL_dev_rogue=6203
CA_dev_rogue="good"
PROFILE_dev_rogue="p384"
USER_dev_rogue="alice"
IMAGE_dev_rogue="golden"

# dev-foreign: EK cert from second, untrusted foreign CA
PORT_AGENT_dev_foreign=7104
PORT_SSH_dev_foreign=2224
PORT_SWTPM_dev_foreign=6104
PORT_CTRL_dev_foreign=6204
CA_dev_foreign="foreign"
PROFILE_dev_foreign="p384"
USER_dev_foreign="bob"
IMAGE_dev_foreign="golden"

# dev-hw: Physical host (e.g. Ryzen laptop fTPM)
PORT_AGENT_dev_hw=7105
PORT_SSH_dev_hw=2225
USER_dev_hw="alice"

# Helper function to query device attributes in shell scripts
get_dev_var() {
  local dev="$1"
  local var="$2"
  local key="${var}_${dev//-/_}"
  echo "${!key:-}"
}
